# SEC EDGAR Identity (Format: "User Name user@domain.com")
# Required by SEC for access to EDGAR submissions via edgartools
SEC_EDGAR_IDENTITY="StockResearcher researcher@example.com"

# Finnhub API Key for company news sentiment (Free tier available at finnhub.io)
# If left empty, sentiment defaults gracefully to neutral (0.0) with indicator status
FINNHUB_API_KEY=""

# Database URL for caching indicator metrics and Form 4 filings
DATABASE_URL="sqlite:///./stock_cache.db"

# Cache time-to-live in minutes before refreshing external data
CACHE_TTL_MINUTES=60

# Server configuration
HOST="0.0.0.0"
PORT=8001

